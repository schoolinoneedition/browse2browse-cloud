{
  "name": "browse2browse-cloud-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Isolated remote Chromium session service for Browse2Browse",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "check": "node --check src/server.js && node --check src/url-policy.js",
    "test": "node --test",
    "test:e2e": "node scripts/e2e-smoke.mjs"
  },
  "dependencies": {
    "ipaddr.js": "2.2.0",
    "playwright": "1.64.1",
    "ws": "8.18.3"
  }
}
